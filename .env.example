# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false

# --- Logging ---
LOG_LEVEL=DEBUG

# --- Database ---
# Choose: postgres | oracle
DB_DIALECT=postgres

# Common connection parts (ignored if DB_DSN is set)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=postgres
# Optional default schema to use (Postgres/Oracle)
DB_SCHEMA=
# Optionally specify a full DSN/URL (overrides the parts above)
# Examples:
#   Postgres: postgresql+psycopg://user:pass@host:5432/dbname
#   Oracle:   oracle+oracledb://user:pass@host:1521/?service_name=FREEPDB1
DB_DSN=

# For Oracle, if using a different service name or port, set DB_NAME and DB_PORT accordingly.
# python-oracledb works in Thin mode by default and does not require Instant Client.

# --- LLM Provider ---
# Choose: anthropic | google | openai | ollama
LLM_PROVIDER=anthropic
# Preferred model name for the selected provider (optional)
LLM_MODEL=

# Anthropic
ANTHROPIC_API_KEY=
# Optional custom base URL
ANTHROPIC_BASE_URL=

# OpenAI
OPENAI_API_KEY=
# Optional custom base URL (e.g., Azure OpenAI or a proxy)
OPENAI_BASE_URL=

# Google Generative AI
GOOGLE_API_KEY=

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
# Default model to use with Ollama
OLLAMA_MODEL=qwen3
